{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run check-types)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:unit *)",
      "Bash(npm run build)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm audit*)",
      "Bash(npm pack --dry-run*)",
      "Bash(npx prettier --check *)",
      "Bash(npx prettier --write *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git merge-base *)",
      "Bash(git rev-parse *)",
      "Bash(git grep *)"
    ],
    "ask": [
      "Bash(npx medusa plugin:db:generate*)",
      "Bash(npx medusa db:*)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npm version*)",
      "Bash(git push *)",
      "Bash(gh release *)",
      "Bash(npm publish*)",
      "Bash(yalc publish*)",
      "Bash(yalc push*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.production)",
      "Edit(.medusa/**)",
      "Edit(src/modules/*/migrations/**)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit *--no-verify*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git config *hooksPath*)",
      "Bash(git config *hookspath*)"
    ]
  }
}
